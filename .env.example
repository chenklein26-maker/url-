# ========================================
# Article Flow 环境变量配置
# ========================================
# 复制此文件为 .env.local 并填入你的配置
# cp .env.example .env.local

# IMAGE_SAVE_PATH: 可选。图片处理后的本地保存路径。
# 设置后，处理过的图片将直接保存到此文件夹并按顺序命名。
IMAGE_SAVE_PATH=

# HTTP_PROXY / HTTPS_PROXY: 可选。代理地址，用于访问受限网站。
# 示例: http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=
